      "source": [
        "import ipywidgets as widgets\n",
        "from IPython.display import display, Audio, HTML\n",
        "from gtts import gTTS\n",
        "import base64\n",
        "import time\n",
        "\n",
        "# Load GSAP library and inject styles\n",
        "gsap_theme = HTML('''\n",
        "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n",
        "<style>\n",
        "    .tts-outer-frame {\n",
        "        display: flex;\n",
        "        justify-content: center;\n",
        "        align-items: center;\n",
        "        width: 100%;\n",
        "        padding: 20px 0;\n",
        "    }\n",
        "    .tts-container {\n",
        "        background: linear-gradient(135deg, #1e1e2f 0%, #0f0f1a 100%);\n",
        "        padding: 40px;\n",
        "        border-radius: 24px;\n",
        "        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6);\n",
        "        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n",
        "        color: #f0f0f5;\n",
        "        width: 800px; /* Base width */\n",
        "        aspect-ratio: 16 / 9; /* Enforce 16:9 8K UHD aspect ratio */\n",
        "        display: flex;\n",
        "        flex-direction: column;\n",
        "        justify-content: space-between;\n",
        "        box-sizing: border-box;\n",
        "        border: 2px solid rgba(255, 255, 255, 0.05);\n",
        "    }\n",
        "    .tts-title {\n",
        "        font-size: 26px;\n",
        "        font-weight: 700;\n",
        "        color: #ffffff;\n",
        "        margin-bottom: 5px;\n",
        "        background: linear-gradient(45deg, #ff7b00, #ffae00);\n",
        "        -webkit-background-clip: text;\n",
        "        -webkit-text-fill-color: transparent;\n",
        "    }\n",
        "    .tts-textarea {\n",
        "        background-color: rgba(255, 255, 255, 0.05) !important;\n",
        "        color: #ffffff !important;\n",
        "        border: 1px solid rgba(255, 255, 255, 0.1) !important;\n",
        "        border-radius: 12px !important;\n",
        "        padding: 12px !important;\n",
        "        font-size: 15px !important;\n",
        "    }\n",
        "    .gsap-btn {\n",
        "        background: linear-gradient(135deg, #ff7b00 0%, #e05300 100%) !important;\n",
        "        color: white !important;\n",
        "        border: none !important;\n",
        "        border-radius: 10px !important;\n",
        "        padding: 12px 28px !important;\n",
        "        font-size: 15px !important;\n",
        "        font-weight: bold !important;\n",
        "        cursor: pointer !important;\n",
        "        box-shadow: 0 4px 15px rgba(255, 123, 0, 0.3) !important;\n",
        "        transition: none !important; /* Managed by GSAP */\n",
        "    }\n",
        "    .gsap-btn-download {\n",
        "        background: linear-gradient(135deg, #00b4db 0%, #0083b0 100%) !important;\n",
        "        color: white !important;\n",
        "        border: none !important;\n",
        "        border-radius: 10px !important;\n",
        "        padding: 12px 28px !important;\n",
        "        font-size: 15px !important;\n",
        "        font-weight: bold !important;\n",
        "        cursor: pointer !important;\n",
        "        box-shadow: 0 4px 15px rgba(0, 180, 219, 0.3) !important;\n",
        "        display: inline-block !important;\n",
        "        text-decoration: none !important;\n",
        "    }\n",
        "</style>\n",
        "<script>\n",
        "    // Bind GSAP animations once elements render\n",
        "    function initGsapAnimations() {\n",
        "        const buttons = document.querySelectorAll('.gsap-btn, .gsap-btn-download');\n",
        "        buttons.forEach(btn => {\n",
        "            btn.addEventListener('mouseenter', () => {\n",
        "                gsap.to(btn, { scale: 1.05, duration: 0.2, ease: 'power1.out', boxShadow: '0 6px 20px rgba(255,123,0,0.5)' });\n",
        "            });\n",
        "            btn.addEventListener('mouseleave', () => {\n",
        "                gsap.to(btn, { scale: 1, duration: 0.2, ease: 'power1.out', boxShadow: '0 4px 15px rgba(255,123,0,0.3)' });\n",
        "            });\n",
        "            btn.addEventListener('mousedown', () => {\n",
        "                gsap.to(btn, { scale: 0.95, duration: 0.1 });\n",
        "            });\n",
        "            btn.addEventListener('mouseup', () => {\n",
        "                gsap.to(btn, { scale: 1.05, duration: 0.1 });\n",
        "            });\n",
        "        });\n",
        "    }\n",
        "    // Poll to apply animation once DOM elements are ready\n",
        "    setTimeout(initGsapAnimations, 500);\n",
        "</script>\n",
        "''')\n",
        "\n",
        "# Create widgets\n",
        "title_widget = widgets.HTML('<div class=\"tts-title\">✨ GSAP Animated Text-to-Speech (16:9)</div>')\n",
        "\n",
        "text_input = widgets.Textarea(\n",
        "    value='Type your custom text here to convert it to speech.',\n",
        "    placeholder='Type something...',\n",
        "    layout=widgets.Layout(width='100%', height='140px')\n",
        ")\n",
        "text_input.add_class('tts-textarea')\n",
        "\n",
        "button = widgets.Button(\n",
        "    description='🔊 Generate & Play',\n",
        "    tooltip='Click to generate speech and download link'\n",
        ")\n",
        "button.add_class('gsap-btn')\n",
        "\n",
        "progress_bar = widgets.IntProgress(\n",
        "    value=0,\n",
        "    min=0,\n",
        "    max=100,\n",
        "    description='Progress:',\n",
        "    bar_style='warning',\n",
        "    style={'description_width': 'initial'},\n",
        "    layout=widgets.Layout(width='100%', display='none')\n",
        ")\n",
        "\n",
        "output_area = widgets.Output()\n",
        "\n",
        "def on_button_clicked(b):\n",
        "    with output_area:\n",
        "        output_area.clear_output()\n",
        "        text = text_input.value.strip()\n",
        "        if not text:\n",
        "            print(\"Please enter some text.\")\n",
        "            return\n",
        "\n",
        "        # Show progress bar and reset its value\n",
        "        progress_bar.layout.display = 'block'\n",
        "        progress_bar.value = 10\n",
        "        time.sleep(0.1)\n",
        "\n",
        "        # Phase 1: Synthesize Speech\n",
        "        progress_bar.value = 30\n",
        "        tts = gTTS(text=text, lang='en')\n",
        "\n",
        "        # Phase 2: Save to local disk\n",
        "        progress_bar.value = 60\n",
        "        filename = \"custom_speech.mp3\"\n",
        "        tts.save(filename)\n",
        "\n",
        "        # Phase 3: Create download payload\n",
        "        progress_bar.value = 80\n",
        "        with open(filename, \"rb\") as f:\n",
        "            data = f.read()\n",
        "        b64 = base64.b64encode(data).decode()\n",
        "\n",
        "        # Download HTML button integrated with GSAP style\n",
        "        download_html = f'''\n",
        "        <div style=\"margin-top: 15px;\">\n",
        "            <a href=\"data:audio/mp3;base64,{b64}\" download=\"{filename}\" class=\"gsap-btn-download\">\n",
        "                ⬇️ Download Audio\n",
        "            </a>\n",
        "        </div>\n",
        "        <script>\n",
        "            if (typeof initGsapAnimations === \"function\") initGsapAnimations();\n",
        "        </script>\n",
        "        '''\n",
        "\n",
        "        # Complete\n",
        "        progress_bar.value = 100\n",
        "        time.sleep(0.2)\n",
        "        progress_bar.layout.display = 'none'\n",
        "\n",
        "        # Display Audio Player and Download Button\n",
        "        display(Audio(filename, autoplay=True))\n",
        "        display(HTML(download_html))\n",
        "\n",
        "button.on_click(on_button_clicked)\n",
        "\n",
        "# Layout the elements in a themed VBox container with 16:9 aspect ratio wrapper\n",
        "inner_container = widgets.VBox([\n",
        "    title_widget,\n",
        "    text_input,\n",
        "    widgets.Box([button], layout=widgets.Layout(margin='15px 0px')),\n",
        "    progress_bar,\n",
        "    output_area\n",
        "], layout=widgets.Layout(width='100%', height='100%', justify_content='space-between'))\n",
        "\n",
        "main_container = widgets.Box([inner_container])\n",
        "main_container.add_class('tts-container')\n",
        "\n",
        "outer_frame = widgets.Box([main_container])\n",
        "outer_frame.add_class('tts-outer-frame')\n",
        "\n",
        "# Render interface\n",
        "display(gsap_theme)\n",
        "display(outer_frame)"
      ],
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<IPython.core.display.HTML object>"
            ],
            "text/html": [
              "\n",
