        "        font-size: 26px;\n",
        "        font-weight: 700;\n",
        "        color: #ffffff;\n",
        "        margin-bottom: 5px;\n",
        "        background: linear-gradient(45deg, #00b4db, #0083b0);\n",
        "        -webkit-background-clip: text;\n",
        "        -webkit-text-fill-color: transparent;\n",
        "    }\n",
        "    .music-textarea {\n",
        "        background-color: rgba(255, 255, 255, 0.05) !important;\n",
        "        color: #ffffff !important;\n",
        "        border: 1px solid rgba(255, 255, 255, 0.1) !important;\n",
        "        border-radius: 12px !important;\n",
        "        padding: 12px !important;\n",
        "        font-size: 15px !important;\n",
        "    }\n",
        "    .gsap-btn-music {\n",
        "        background: linear-gradient(135deg, #00b4db 0%, #0083b0 100%) !important;\n",
        "        color: white !important;\n",
        "        border: none !important;\n",
        "        border-radius: 10px !important;\n",
        "        padding: 12px 28px !important;\n",
        "        font-size: 15px !important;\n",
        "        font-weight: bold !important;\n",
        "        cursor: pointer !important;\n",
        "        box-shadow: 0 4px 15px rgba(0, 180, 219, 0.3) !important;\n",
        "        transition: none !important;\n",
        "    }\n",
        "    .gsap-btn-music-download {\n",
        "        background: linear-gradient(135deg, #ff7b00 0%, #e05300 100%) !important;\n",
        "        color: white !important;\n",
        "        border: none !important;\n",
        "        border-radius: 10px !important;\n",
        "        padding: 12px 28px !important;\n",
        "        font-size: 15px !important;\n",
        "        font-weight: bold !important;\n",
        "        cursor: pointer !important;\n",
        "        box-shadow: 0 4px 15px rgba(255, 123, 0, 0.3) !important;\n",
        "        display: inline-block !important;\n",
        "        text-decoration: none !important;\n",
        "    }\n",
        "</style>\n",
        "<script>\n",
        "    function initMusicGsapAnimations() {\n",
        "        const buttons = document.querySelectorAll('.gsap-btn-music, .gsap-btn-music-download');\n",
        "        buttons.forEach(btn => {\n",
        "            btn.addEventListener('mouseenter', () => {\n",
        "                gsap.to(btn, { scale: 1.05, duration: 0.2, ease: 'power1.out' });\n",
        "            });\n",
        "            btn.addEventListener('mouseleave', () => {\n",
        "                gsap.to(btn, { scale: 1, duration: 0.2, ease: 'power1.out' });\n",
        "            });\n",
        "            btn.addEventListener('mousedown', () => {\n",
        "                gsap.to(btn, { scale: 0.95, duration: 0.1 });\n",
        "            });\n",
        "            btn.addEventListener('mouseup', () => {\n",
        "                gsap.to(btn, { scale: 1.05, duration: 0.1 });\n",
        "            });\n",
        "        });\n",
        "    }\n",
        "    setTimeout(initMusicGsapAnimations, 500);\n",
        "</script>\n",
        "''')\n",
        "\n",
        "# Create widgets\n",
        "title_widget = widgets.HTML('<div class=\"music-title\">🎵 GSAP Animated Music Generator (16:9)</div>')\n",
        "\n",
        "prompt_input = widgets.Textarea(\n",
        "    value='An upbeat electronic synth wave loop with heavy bass.',\n",
        "    placeholder='Type your music prompt here...',\n",
        "    layout=widgets.Layout(width='100%', height='140px')\n",
        ")\n",
        "prompt_input.add_class('music-textarea')\n",
        "\n",
        "button = widgets.Button(\n",
        "    description='🎹 Synthesize Song',\n",
        "    tooltip='Click to synthesize a custom waveform based on your prompt'\n",
        ")\n",
        "button.add_class('gsap-btn-music')\n",
        "\n",
        "progress_bar = widgets.IntProgress(\n",
        "    value=0,\n",
        "    min=0,\n",
        "    max=100,\n",
        "    description='Generating:',\n",
        "    bar_style='info',\n",
        "    style={'description_width': 'initial'},\n",
        "    layout=widgets.Layout(width='100%', display='none')\n",
        ")\n",
        "\n",
        "output_area = widgets.Output()\n",
        "\n",
        "def generate_procedural_music(prompt):\n",
        "    \"\"\"Generates a custom synthetic WAV waveform based on the prompt text\"\"\"\n",
        "    sample_rate = 22050\n",
        "    duration = 120.0  # Modified to 2 minutes (120 seconds)\n",
        "    t = np.linspace(0, duration, int(sample_rate * duration), endpoint=False)\n",
        "\n",
        "    # Determine qualities from user prompt to shape the sound waves\n",
        "    prompt_lower = prompt.lower()\n",
        "    freq1, freq2 = 220.0, 440.0 # Default synth\n",
        "\n",
        "    if \"bass\" in prompt_lower or \"heavy\" in prompt_lower:\n",
        "        freq1 = 110.0\n",
        "    if \"high\" in prompt_lower or \"ambient\" in prompt_lower:\n",
        "        freq1, freq2 = 440.0, 880.0\n",
        "    if \"chill\" in prompt_lower or \"soft\" in prompt_lower:\n",
        "        freq1, freq2 = 165.0, 330.0\n",
        "\n",
        "    # Synthesize waves\n",
        "    wave1 = np.sin(2 * np.pi * freq1 * t)\n",
        "    wave2 = 0.5 * np.sin(2 * np.pi * freq2 * t)\n",
        "    combined = wave1 + wave2\n",
        "\n",
        "    # Normalize track\n",
        "    normalized = np.int16(combined / np.max(np.abs(combined)) * 32767)\n",
        "    return sample_rate, normalized\n",
        "\n",
        "def on_button_clicked(b):\n",
        "    with output_area:\n",
        "        output_area.clear_output()\n",
        "        prompt = prompt_input.value.strip()\n",
        "        if not prompt:\n",
        "            print(\"Please write a music generation prompt.\")\n",
        "            return\n",
        "\n",
        "        progress_bar.layout.display = 'block'\n",
        "        progress_bar.value = 20\n",
        "        time.sleep(0.3)\n",
        "\n",
        "        # Phase 1: Parsing prompts & setting registers\n",
        "        progress_bar.value = 50\n",
        "        sample_rate, audio_data = generate_procedural_music(prompt)\n",
        "        time.sleep(0.3)\n",
        "\n",
        "        # Phase 2: Generating synthetic wave elements\n",
        "        progress_bar.value = 80\n",
        "        filename = \"generated_song.wav\"\n",
        "        wav.write(filename, sample_rate, audio_data)\n",
        "\n",
        "        # Phase 3: Exporting file to base64 encoding\n",
        "        with open(filename, \"rb\") as f:\n",
        "            data = f.read()\n",
        "        b64 = base64.b64encode(data).decode()\n",
        "\n",
        "        download_html = f'''\n",
        "        <div style=\"margin-top: 15px;\">\n",
        "            <a href=\"data:audio/wav;base64,{b64}\" download=\"{filename}\" class=\"gsap-btn-music-download\">\n",
        "                ⬇️ Download Track\n",
        "            </a>\n",
        "        </div>\n",
        "        <script>\n",
        "            if (typeof initMusicGsapAnimations === \"function\") initMusicGsapAnimations();\n",
        "        </script>\n",
        "        '''\n",
        "\n",
        "        progress_bar.value = 100\n",
        "        time.sleep(0.2)\n",
        "        progress_bar.layout.display = 'none'\n",
        "\n",
        "        display(Audio(filename, autoplay=True))\n",
        "        display(HTML(download_html))\n",
        "\n",
        "button.on_click(on_button_clicked)\n",
        "\n",
        "inner_container = widgets.VBox([\n",
        "    title_widget,\n",
        "    prompt_input,\n",
        "    widgets.Box([button], layout=widgets.Layout(margin='15px 0px')),\n",
        "    progress_bar,\n",
        "    output_area\n",
        "], layout=widgets.Layout(width='100%', height='100%', justify_content='space-between'))\n",
        "\n",
        "main_container = widgets.Box([inner_container])\n",
        "main_container.add_class('music-container')\n",
        "\n",
        "outer_frame = widgets.Box([main_container])\n",
        "outer_frame.add_class('tts-outer-frame')\n",
        "\n",
        "display(music_theme)\n",
        "display(outer_frame)"
      ],
